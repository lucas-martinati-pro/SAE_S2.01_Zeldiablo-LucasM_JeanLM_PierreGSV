@startuml
title Q7 - Diagramme Classes v2

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

class "Jeu" as ZJeu {
    - laby : Labyrinthe
    - hero : Aventurier
    - monstres : ArrayList<Personnage>
    - fin : int[]
    - cases : ArrayList<Case>
    + {static} HAUT : String = "Haut"
    + {static} BAS : String = "Bas"
    + {static} GAUCHE : String = "Gauche"
    + {static} DROITE : String = "Droite"
    + {static} SPACE : String = "Space"

    + setHero(hero : Aventurier) : void
    + setLaby(laby : Labyrinthe) : void
    + getHero() : Aventurier
    + getLaby() : Labyrinthe
    + getCases() : ArrayList<Case>
    + getMonstres() : ArrayList<Personnage>
    + getCase(x : int, y : int) : Case
    + chargerJeu(nomFichier : String) : void
    + {static} convertLab(nomFichier : String, ligne : ArrayList<String>) : Labyrinthe
    + getChar(x : int, y : int) : char
    + detruire(x : int, y : int) : void
    + getSuivant(x : int, y : int, commandeUser : Commande) : int[]
    + addBombe(x : int, y : int) : void
    + monstreAttaque(x : int, y : int) : void
    + verifierDeplacement(x : int, y : int, commandeUser : Commande) : void
    + evoluer(commandeUser : Commande) : void
    + evoluerMonster(commandeUser : Commande) : void
    + etreFini() : boolean
    + verifMort() : void
    + startMonsters() : void
    + evoluer(action : String) : void
    + verifierDeplacement(x : int, y : int, action : String) : void
    + jeuToString() : String
}

class DessinLaby {
    - jeu : Jeu

    + DessinLaby(jeu : Jeu)
    + dessiner(image : BufferedImage) : void
}

' ========================
' Package entite
' ========================
package "entite" {

    abstract class Personnage {
        # x : int
        # y : int
        # vie : int

        + Personnage(x : int, y : int, vie : int)
        + getX() : int
        + getY() : int
        + getVie() : int
        + setPos(x : int, y : int) : void
        + addVie(i : int) : void
        + etreMort() : boolean
        + attaquer(victime : Personnage) : void
    }

    class Aventurier {
        - jeu : Jeu

        + Aventurier(x : int, y : int, vie : int)
        + attaquer(jeu : Jeu) : void
    }

    class Monstre {
        + Monstre(x : int, y : int, vie : int)
    }

    Personnage <|-- Aventurier
    Personnage <|-- Monstre
}

' ========================
' Package environnement
' ========================
package "environnement" {

    interface Case <<interface>> {
        + getType() : String
        + getCoord() : int[]
        + effet(perso : Personnage) : void
    }

    class Labyrinthe {
        - murs : boolean[][]
        + {static} MUR : char = '#'
        + {static} HERO : char = '@'
        + {static} MONSTRE : char = '£'
        + {static} FIN : char = '&'
        + {static} VIDE : char = ' '
        + {static} PIEGE : char = '$'
        + {static} MurFriable : char = '*'
        + {static} BOMBE : char = 'B'

        + Labyrinthe(x : int, y : int)
        + addMur(x : int, y : int) : void
        + returnSize() : int[]
        + getCase(x : int, y : int) : boolean
    }

    class Piege {
        - x : int
        - y : int
        - isRevele : boolean

        + Piege(x : int, y : int)
        + getType() : String
        + getCoord() : int[]
        + getIsRevele() : boolean
        + effet(perso : Personnage) : void
    }

    class MurFriable {
        - x : int
        - y : int

        + MurFriable(x : int, y : int)
        + getType() : String
        + getCoord() : int[]
        + effet(perso : Personnage) : void
    }

    class Bombe {
        - x : int
        - y : int
        - jeu : Jeu

        + Bombe(x : int, y : int)
        + setJeu(jeu : Jeu) : void
        + getType() : String
        + getCoord() : int[]
        + effet(perso : Personnage) : void
    }

    Case <|.. Piege
    Case <|.. MurFriable
    Case <|.. Bombe
}

' ========================
' Package exception
' ========================
package "exception" {

    class ActionInconnueException {
        + ActionInconnueException(message : String)
    }

    class FichierIncorrectException {
        + FichierIncorrectException(message : String)
    }

    ActionInconnueException --|> RuntimeException
    FichierIncorrectException --|> RuntimeException
}

' ========================
' Relations inter-packages
' ========================

' Jeu implémente moteurJeu.Jeu
Jeu <|.. ZJeu

' DessinLaby implémente DessinJeu
DessinJeu <|.. DessinLaby

' Jeu possède / utilise
ZJeu --> Labyrinthe : laby
ZJeu --> Aventurier : hero
ZJeu "1" --> "*" Personnage : monstres
ZJeu "1" --> "*" Case : cases

' DessinLaby affiche Jeu
DessinLaby "1" --> "1" ZJeu : jeu

' Aventurier utilise Bombe via Jeu
Aventurier ..> Bombe : pose
Aventurier ..> ZJeu : utilise

' Bombe a une référence vers Jeu pour l'explosion
Bombe --> ZJeu : jeu

' Jeu lève des exceptions
ZJeu ..> ActionInconnueException : lève
ZJeu ..> FichierIncorrectException : lève

@enduml
